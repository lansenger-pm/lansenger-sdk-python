#!/usr/bin/env bash
# pre-commit 门禁（Harness ⑤验证层·提交前阻断）
#
# 激活（人工一次）：git config core.hooksPath scripts/hooks
# 取消：git config --unset core.hooksPath
set -u
cd "$(dirname "$0")/../.."
echo "[pre-commit] 运行统一验证：bash scripts/verify.sh"
bash scripts/verify.sh || {
  echo "[pre-commit] verify 未全绿（FAIL>0），提交被阻断。修复后重试，或向人工说明原因。"
  exit 1
}
